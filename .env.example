# Configuration template; the web app reads exported environment variables.
# It does not automatically load .env. Never commit filled-in secrets.
# Keep production values in your organization's secret manager.
OPENAI_API_KEY=sk-...

# Required for the Slack bot. Use a dedicated, least-privilege read-only
# database account; see ORG_ONBOARDING.md.
DB_URL=postgresql://sql_assistant:password@db.example.com:5432/analytics
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# Optional OpenAI-compatible provider settings.
LLM_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=http://localhost:11434/v1

# Optional browser generation; defaults to false and makes no provider calls.
SQL_LLM_ENABLED=false
SQL_LLM_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://your-provider.example/v1

# Required when enabling browser generation. Set a random secret >=32 characters.
# Do not use a predictable example value or commit the actual token.
# SQL_GENERATION_TOKEN=
